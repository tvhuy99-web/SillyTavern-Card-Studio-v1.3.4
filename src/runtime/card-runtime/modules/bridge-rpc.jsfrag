    // Transport glue only. The request lifecycle is owned by the RPC client.
    const rpcClient = (/*__STS_RPC_CLIENT_FACTORY__*/)({
        send: function (message) { root.parent.postMessage(message, '*'); },
        makeId: uuid,
        readContext: function () { return BOOT.context; },
        clone: clone,
        onTimeout: function (method, message) {
            diagnostic('CARD_RUNTIME_RPC_TIMEOUT', 'rpc', 'bridge', message, { method: method, scriptId: activeScriptId });
        }
    });
    const rpc = rpcClient.request;
    root.cardRuntimeRpc = rpc;
    root.addEventListener('pagehide', function (event) {
        if (event.persisted) rpcClient.cancelPending('Card runtime page was suspended.');
        else rpcClient.close();
    });
