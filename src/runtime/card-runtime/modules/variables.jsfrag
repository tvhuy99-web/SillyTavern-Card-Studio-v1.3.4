    const scriptRegistry = new Map();
    const variableReadTrace = [];
    const missingVariablePaths = [];
    let variableHandshakeApplied = false;

    function summarizeVariableObject(value) {
        const object = asObject(value);
        const keys = Object.keys(object);
        const hasStatData = Object.prototype.hasOwnProperty.call(object, 'stat_data') && asObject(object.stat_data) === object.stat_data;
        const stateObject = hasStatData ? asObject(object.stat_data) : object;
        return {
            keyCount: keys.length,
            keys: keys.slice(0, 32),
            hasStatData: hasStatData,
            stateKeyCount: Object.keys(stateObject).length,
            stateKeys: Object.keys(stateObject).slice(0, 32)
