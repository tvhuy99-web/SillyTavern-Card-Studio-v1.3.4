            scriptName: activeScriptName,
            keyCount: summary.keyCount,
            hasStatData: summary.hasStatData,
            stateKeyCount: summary.stateKeyCount
        }, details || {});
        variableReadTrace.push(entry);
        if (variableReadTrace.length > 40) variableReadTrace.splice(0, variableReadTrace.length - 40);
        if (entry.missing === true && entry.path) {
            const path = String(entry.path);
            if (!missingVariablePaths.includes(path)) missingVariablePaths.push(path);
            if (missingVariablePaths.length > 24) missingVariablePaths.splice(0, missingVariablePaths.length - 24);
        }
    }
    function variableReadinessSnapshot() {
        const scopes = {};
        let totalKeyCount = 0;
        let populatedScopeCount = 0;
        scopeCache.forEach(function (value, key) {
            const summary = summarizeVariableObject(value);
            scopes[key] = summary;
            totalKeyCount += summary.keyCount;
            if (summary.keyCount > 0) populatedScopeCount += 1;
        });
        const chatSummary = summarizeVariableObject(scopeCache.get('chat') || {});
        return {
            handshakeApplied: variableHandshakeApplied,
            scopeCount: scopeCache.size,
            populatedScopeCount: populatedScopeCount,
            totalKeyCount: totalKeyCount,
            chat: chatSummary,
            scopes: scopes,
            missingPaths: missingVariablePaths.slice(),
            recentReads: variableReadTrace.slice(-20)
