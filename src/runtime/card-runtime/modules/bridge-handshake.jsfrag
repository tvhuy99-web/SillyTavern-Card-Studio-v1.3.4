    let readyResolve;
    let readyReject;
    let handshakeSettled = false;
    let handshakeTimeout = 0;
    root.__cardRuntimeHandshakeReady = new Promise(function (resolve, reject) { readyResolve = resolve; readyReject = reject; });
    if (root.__cardRuntimeBootState) {
        root.__cardRuntimeBootState.phase = 'handshake-waiting';
        root.__cardRuntimeBootState.handshakeStartedAt = Date.now();
    }
    root.addEventListener('message', function (event) {
        if (event.source !== root.parent || !event.data) return;
        const data = event.data;
        if (data.type === 'CARD_RUNTIME_MIRROR_SUBSCRIBE') {
            mirrorSubscribed = true;
            startMirrorObserver();
            setTimeout(sendMirrorSnapshot, 0);
            return;
        }
        if (data.type === 'CARD_RUNTIME_MIRROR_UNSUBSCRIBE') {
            mirrorSubscribed = false;
            stopMirrorObserver();
            return;
        }
        if (data.type === 'CARD_RUNTIME_MIRROR_REQUEST') {
            mirrorSubscribed = true;
            startMirrorObserver();
            sendMirrorSnapshot();
            return;
        }
        if (data.type === 'CARD_RUNTIME_RPC_RESULT') {
            rpcClient.receive(data);
            return;
        }
        if (data.type === 'CARD_RUNTIME_EVENT') {
            emitEvent.apply(null, [data.eventName].concat(Array.isArray(data.args) ? data.args : []));
            return;
        }
        if (data.type === 'CARD_RUNTIME_STATE_UPDATE') {
            if (data.payload && data.payload.chatHistory) chatHistory = clone(data.payload.chatHistory);
            if (data.payload && data.payload.extensionSettings) extensionSettings = clone(data.payload.extensionSettings);
            if (data.payload && Array.isArray(data.payload.worldInfo)) worldInfo = clone(data.payload.worldInfo);
            if (data.payload && Array.isArray(data.payload.lorebookNames)) lorebookNames = Array.from(new Set(data.payload.lorebookNames.map(String)));
            if (data.payload && data.payload.variableScopes) {
                applyVariableScopesPayload(data.payload.variableScopes, 'state-update', true);
            }
            syncContext();
            return;
        }
        if (data.type === 'HANDSHAKE_ACK') {
            if (handshakeSettled) return;
            if (data.payload && Array.isArray(data.payload.chatHistory)) chatHistory = clone(data.payload.chatHistory);
            if (data.payload && data.payload.extensionSettings) extensionSettings = clone(data.payload.extensionSettings);
            if (data.payload && Array.isArray(data.payload.worldInfo)) worldInfo = clone(data.payload.worldInfo);
            if (data.payload && Array.isArray(data.payload.lorebookNames)) lorebookNames = Array.from(new Set(data.payload.lorebookNames.map(String)));
            applyVariableScopesPayload(data.payload && data.payload.variableScopes, 'handshake', true);
            syncContext();
            handshakeSettled = true;
            if (handshakeTimeout) { clearTimeout(handshakeTimeout); handshakeTimeout = 0; }
            if (root.__cardRuntimeBootState) {
                root.__cardRuntimeBootState.phase = 'handshake-ready';
                root.__cardRuntimeBootState.handshakeReadyAt = Date.now();
            }
            readyResolve(true);
            setTimeout(function () {
                emitEvent(root.tavern_events.CHAT_CHANGED, BOOT.context.chatId);
                emitEvent(root.tavern_events.EXTENSION_SETTINGS_LOADED);
                emitEvent(root.tavern_events.SETTINGS_LOADED);
                emitEvent(root.tavern_events.APP_READY);
            }, 0);
        }
        if (data.type === 'EXECUTE_BUTTON_SCRIPT' && data.payload) emitEvent('btn_click_' + data.payload.buttonName);
    });


    function failHandshake(error) {
        if (handshakeSettled) return;
        handshakeSettled = true;
        if (handshakeTimeout) { clearTimeout(handshakeTimeout); handshakeTimeout = 0; }
        readyReject(error);
    }

    function startHandshake() {
        handshakeTimeout = setTimeout(function () {
            if (handshakeSettled) return;
            const message = 'Card Runtime handshake timed out before HANDSHAKE_ACK.';
            if (root.__cardRuntimeBootState) {
                root.__cardRuntimeBootState.phase = 'handshake-timeout';
                root.__cardRuntimeBootState.handshakeTimeoutAt = Date.now();
            }
            failHandshake(new Error(message));
            diagnostic('CARD_RUNTIME_RPC_TIMEOUT', 'handshake', 'bridge', message, { method: 'HANDSHAKE_INIT' });
        }, 5000);
        try {
            root.parent.postMessage({ type: 'HANDSHAKE_INIT', payload: { messageId: BOOT.context.messageId } }, '*');
        } catch (error) {
            failHandshake(error);
        }
    }
    root.addEventListener('pagehide', function (event) {
        if (!event.persisted) failHandshake(new Error('Card runtime closed before handshake completed.'));
    });
