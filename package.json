{
  "name": "sillytavern-card-studio",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.js",
    "build": "npm run build:bundle && node build/build-portable.mjs",
    "start": "node server.js",
    "build:bundle": "node build/build-production-bundle.mjs",
    "test": "node tools/run-tests.mjs",
    "test:storage-browser": "node tools/test-storage-browser.mjs",
    "test:app-browser": "node tools/test-app-browser.mjs",
    "test:native-java": "node tools/test-native-java.mjs",
    "test:android-overlay": "python3 tests/native/test-overlay.py",
    "build:npm": "node build/build-npm-runtime.mjs",
    "verify:vendor": "node tools/vendor-inventory.mjs",
    "audit:vendor": "node tools/vendor-inventory.mjs --write",
    "test:npm-runtime": "node tools/test-npm-runtime.mjs",
    "build:source": "node build/build-source.mjs",
    "audit:boundaries": "node tools/audit-module-graph.cjs --check",
    "audit:quality": "node tools/audit-phase1-quality.mjs",
    "audit:npm-dependencies": "node tools/audit-npm-dependencies.mjs",
    "start:source": "node server.js --dist-source",
    "start:npm": "node server.js --dist-npm",
    "test:source-bootstrap": "node tools/test-source-bootstrap.mjs"
  }
}
